#!/bin/bash
#SBATCH --job-name=spatial_downstream
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=48:00:00
#SBATCH --output=logs/spatial_downstream_%j.out
#SBATCH --error=logs/spatial_downstream_%j.err

# Downstream spatial scripts that consume outputs regenerated by the GLS2 marker fix
# (04a -> 05b -> 09a rerun). Runs scripts in dependency order; independent scripts
# within a wave run in parallel via background processes.
#
# Dependency graph:
#   Wave 1 (parallel): 04b, 09d, 12, 17a
#   Wave 2 (parallel): 09b, 09c              [after 04b]
#   Wave 3 (serial):   06                    [after 04b + 09b + 09c + 09d]
#   Wave 4 (serial):   07                    [after 06]
#   Wave 5 (serial):   17b                   [after 17a]
#
# Regenerated inputs consumed:
#   zonation/zonation_scores.csv             -> 09c, 07, 09d(n/a)
#   zonation/spatial_with_zonation.h5ad      -> 04b
#   zonation/zonation_aware_de.csv           -> 06
#   zonation/zone_specific_masld_genes.csv   -> (used by 04b internally)
#   zonation/zonation_validation.csv         -> reference only
#   communication/ligrec_*.csv               -> 07 (glob)
#   communication/differential_lr_pairs.csv  -> 07
#   communication/network_*.csv              -> 07 (glob)

set -euo pipefail

SPATIAL_DIR="/gpfs/commons/groups/sanjana_lab/Cas13/MASLD_library_design/Analysis/Spatial"
SCRIPTS="${SPATIAL_DIR}/scripts"
LOGS="${SPATIAL_DIR}/logs"

cd "${SPATIAL_DIR}"

eval "$(/gpfs/commons/home/jameslee/.local/bin/micromamba shell hook -s bash)"
micromamba activate spatial

# Helper: run a script, tee output to a dedicated per-script log, exit on failure
run_script() {
    local name="$1"
    local script="$2"
    local logfile="${LOGS}/${name}_${SLURM_JOB_ID}.out"
    echo "=== [$(date '+%H:%M:%S')] START ${name} ==="
    python "${SCRIPTS}/${script}" 2>&1 | tee "${logfile}"
    local rc="${PIPESTATUS[0]}"
    if [ "${rc}" -ne 0 ]; then
        echo "=== [$(date '+%H:%M:%S')] FAILED ${name} (exit ${rc}) ==="
        return "${rc}"
    fi
    echo "=== [$(date '+%H:%M:%S')] DONE  ${name} ==="
}

# ── Wave 1 (parallel): 04b, 09d, 12, 17a ────────────────────────────────────
# 04b: reads spatial_with_zonation.h5ad -> produces deg_zonation_classification.csv,
#      zonation_disruption_scores.csv
# 09d: reads cell2location h5ad (no regenerated inputs) -> cross_modality_validation.csv
# 12:  recomputes zonation+LR from preprocessed h5ad -> validation_bulk/ CSVs
# 17a: reads ontrac/gsmap/commot/multisp sub-pipeline outputs (no regenerated inputs)
#      -> spatial_integration/cross_method_convergence.csv

echo "=========================================="
echo "Wave 1: 04b + 09d + 12 + 17a (parallel)"
echo "=========================================="

run_script "04b_deg_zonation_mapping"       "04b_deg_zonation_mapping.py"    &
PID_04B=$!

run_script "09d_cross_modality_validation"  "09d_cross_modality_validation.py" &
PID_09D=$!

run_script "12_zonation_lr_validation"      "12_zonation_lr_validation.py"   &
PID_12=$!

run_script "17a_unified_spatial_integration" "17a_unified_spatial_integration.py" &
PID_17A=$!

# Wait for Wave 1; capture exit codes individually so failures are reported clearly
WAVE1_FAIL=0
wait "${PID_04B}"  || { echo "ERROR: 04b failed"; WAVE1_FAIL=1; }
wait "${PID_09D}"  || { echo "ERROR: 09d failed"; WAVE1_FAIL=1; }
wait "${PID_12}"   || { echo "ERROR: 12 failed";  WAVE1_FAIL=1; }
wait "${PID_17A}"  || { echo "ERROR: 17a failed"; WAVE1_FAIL=1; }

if [ "${WAVE1_FAIL}" -ne 0 ]; then
    echo "Wave 1 had failures — aborting pipeline"
    exit 1
fi

echo ""
echo "=========================================="
echo "Wave 2: 09b + 09c (parallel, after 04b)"
echo "=========================================="
# 09b: reads deg_zonation_classification.csv (from 04b) -> coloc_zonation_mapping.csv
# 09c: reads zonation_scores.csv (from 04a, already done) + deg_zonation_classification.csv
#      (from 04b) -> spatial_niche_targets.csv

run_script "09b_spatial_gwas_overlay"  "09b_spatial_gwas_overlay.py"  &
PID_09B=$!

run_script "09c_niche_drug_targets"    "09c_niche_drug_targets.py"    &
PID_09C=$!

WAVE2_FAIL=0
wait "${PID_09B}" || { echo "ERROR: 09b failed"; WAVE2_FAIL=1; }
wait "${PID_09C}" || { echo "ERROR: 09c failed"; WAVE2_FAIL=1; }

if [ "${WAVE2_FAIL}" -ne 0 ]; then
    echo "Wave 2 had failures — aborting pipeline"
    exit 1
fi

echo ""
echo "=========================================="
echo "Wave 3: 06 (after 04b + 09b + 09c + 09d)"
echo "=========================================="
# 06: reads deg_zonation_classification.csv (04b), zonation_aware_de.csv (09a, done),
#     coloc_zonation_mapping.csv (09b), spatial_niche_targets.csv (09c),
#     cross_modality_validation.csv (09d)
#  -> integration/multi_evidence_atlas_with_spatial.csv, integration/spatial_enrichment_tests.csv

run_script "06_integration" "06_integration.py"

echo ""
echo "=========================================="
echo "Wave 4: 07 (after 06)"
echo "=========================================="
# 07: reads deg_zonation_classification.csv (04b), zonation_scores.csv (04a, done),
#     differential_lr_pairs.csv (05b, done), network_*.csv (05b, done),
#     spatial_enrichment_tests.csv (06), zonation_disruption_scores.csv (04b)

run_script "07_spatial_figures" "07_spatial_figures.py"

echo ""
echo "=========================================="
echo "Wave 5: 17b (after 17a)"
echo "=========================================="
# 17a already finished in Wave 1
# 17b: reads cross_method_convergence.csv (17a) and gsmap/ files

run_script "17b_spatial_main_figure" "17b_spatial_main_figure.py"

echo ""
echo "=========================================="
echo "All spatial downstream scripts complete: $(date)"
echo "=========================================="
