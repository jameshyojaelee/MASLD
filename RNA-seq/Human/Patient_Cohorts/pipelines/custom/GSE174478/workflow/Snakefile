# =============================================================================
# Retroactive Snakefile for GSE174478 (Chen et al.)
# Documents the exact STAR + featureCounts commands used for the STAR
# sensitivity arm. Created 2026-05-26 as a provenance artifact.
#
# Dataset: GSE174478 — paired-end RNA-seq (Illumina), 94 liver biopsy samples
# Library layout: PAIRED-END
# Quantification: STAR 2.7.11b → featureCounts 2.1.1 (bulk, reverse-stranded)
#
# Original execution: shared/Snakefile via submit_pipeline.sh + cluster jobs,
#   with a standalone run_featurecounts.sh for the bulk featureCounts step.
# STAR command (from Log.out):
#   STAR --runThreadN {threads} --genomeDir {STAR_INDEX}
#        --readFilesIn {R1} {R2} --readFilesCommand zcat
#        --outFileNamePrefix {prefix} --outSAMtype BAM SortedByCoordinate
#        --twopassMode Basic --quantMode GeneCounts
#        --limitBAMsortRAM 30000000000
# featureCounts command (from gene_counts.txt header):
#   featureCounts -T 8 -p --countReadPairs -B -s 2 -a {GTF} -o gene_counts.txt {BAMs...}
# =============================================================================

from pathlib import Path
import csv

configfile: "workflow/config.yaml"
root = Path(config["project_root"]).resolve()
samplesheet = Path(config["samplesheet"]).resolve()

samples = {}
if samplesheet.exists():
    with samplesheet.open() as handle:
        reader = csv.DictReader(handle, delimiter='\t')
        for row in reader:
            samples[row['sample_id']] = row

SAMPLES = sorted(samples)

def fastq(sample, read):
    entry = samples[sample]
    key = f"fastq_{read.lower()}"
    value = (entry.get(key) or "").strip()
    if not value:
        return ""
    p = Path(value)
    if p.is_absolute():
        return str(p)
    return str(root / value)

def fastq_paths(sample):
    return [path for path in (fastq(sample, 'R1'), fastq(sample, 'R2')) if path]

FASTQC_DIR = root / config['qc']['fastqc_dir']
MULTIQC_DIR = root / config['qc']['multiqc_dir']
STAR_OUT = root / config['alignment']['star_out']
FEATURECOUNTS_DIR = root / config['alignment']['featurecounts_out']
STAR_INDEX = root / config['indices']['star']
GTF = root / config['reference']['gtf']
THREADS = config['threads']
PIPELINE_LOG_DIR = root / config['pipeline_logs']

rule all:
    input:
        MULTIQC_DIR / "multiqc_report.html",
        expand(STAR_OUT / "{sample}" / "{sample}.Aligned.sortedByCoord.out.bam", sample=SAMPLES),
        FEATURECOUNTS_DIR / "gene_counts.txt",

rule run_fastqc:
    input:
        lambda wildcards: fastq_paths(wildcards.sample)
    output:
        r1_html=FASTQC_DIR / "{sample}_fastqc.html",
        r1_zip=FASTQC_DIR / "{sample}_fastqc.zip",
    params:
        outdir=FASTQC_DIR
    threads: THREADS['fastqc']
    log: PIPELINE_LOG_DIR / "fastqc" / "{sample}.log"
    run:
        shell("mkdir -p {params.outdir} $(dirname {log})")
        shell(
            "fastqc --threads {threads} --outdir {params.outdir} {input} > {log} 2>&1"
        )

rule run_star:
    input:
        lambda wc: fastq_paths(wc.sample)
    output:
        bam=STAR_OUT / "{sample}" / "{sample}.Aligned.sortedByCoord.out.bam",
        sj=STAR_OUT / "{sample}" / "{sample}.SJ.out.tab",
        gene_counts=STAR_OUT / "{sample}" / "{sample}.ReadsPerGene.out.tab",
        log_final=STAR_OUT / "{sample}" / "{sample}.Log.final.out"
    params:
        outdir=lambda wc: STAR_OUT / wc.sample,
        prefix=lambda wc: STAR_OUT / wc.sample / f"{wc.sample}."
    threads: THREADS['star']
    log: PIPELINE_LOG_DIR / "star" / "{sample}.log"
    shell:
        "mkdir -p {params.outdir} $(dirname {log}) && "
        "STAR --runThreadN {threads} --genomeDir {STAR_INDEX} "
        "--readFilesIn {input} --readFilesCommand zcat "
        "--outFileNamePrefix {params.prefix} --outSAMtype BAM SortedByCoordinate "
        "--twopassMode Basic --quantMode GeneCounts --limitBAMsortRAM 30000000000 > {log} 2>&1"

rule featurecounts:
    shell:
        "echo 'ERROR: live GSE174478 counting is disabled; use "
        "scripts/bg001_remediation/recount_array.sbatch with a frozen BAM manifest and candidate run root.' >&2; "
        "exit 64"

rule multiqc:
    input:
        expand(STAR_OUT / "{sample}" / "{sample}.Log.final.out", sample=SAMPLES),
        FEATURECOUNTS_DIR / "gene_counts.txt"
    output:
        MULTIQC_DIR / "multiqc_report.html"
    params:
        outdir=MULTIQC_DIR
    log: PIPELINE_LOG_DIR / "multiqc.log"
    shell:
        "mkdir -p {params.outdir} $(dirname {log}) && "
        "multiqc {root} -o {params.outdir} > {log} 2>&1"
