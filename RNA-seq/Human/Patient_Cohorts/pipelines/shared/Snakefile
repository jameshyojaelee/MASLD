# =============================================================================
# Shared Snakefile for Human MASLD RNA-seq per-dataset processing
# Used by all datasets — do NOT copy this file to individual dataset dirs.
#
# Each dataset has its own workflow/config.yaml pointing here via the -s flag:
#   snakemake -s ../../shared/Snakefile --configfile workflow/config.yaml ...
#
# Workflow: FASTQ → FastQC → STAR alignment → featureCounts → MultiQC
# =============================================================================

from pathlib import Path
import csv
import subprocess
import sys

root        = Path(config["project_root"]).resolve()
samplesheet = Path(config["samplesheet"]).resolve()

# ---------------------------------------------------------------------------
# Load sample manifest
# ---------------------------------------------------------------------------
samples = {}
if samplesheet.exists():
    with samplesheet.open() as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        for row in reader:
            samples[row["sample_id"]] = row

SAMPLES = sorted(samples)

if not SAMPLES:
    raise ValueError(f"No samples loaded from samplesheet: {samplesheet}")

# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------
def fastq_path(sample, read):
    """Return absolute FASTQ path for a sample/read, or '' if not present."""
    entry = samples[sample]
    key = f"fastq_{read.lower()}"
    value = (entry.get(key) or "").strip()
    if not value:
        return ""
    p = Path(value)
    return str(p) if p.is_absolute() else str(root / value)

def fastq_paths(sample):
    return [p for p in (fastq_path(sample, "R1"), fastq_path(sample, "R2")) if p]

def is_paired(sample):
    return bool(fastq_path(sample, "R2"))

PAIRED  = [s for s in SAMPLES if is_paired(s)]
SINGLE  = [s for s in SAMPLES if not is_paired(s)]

# ---------------------------------------------------------------------------
# Directory variables (from config)
# ---------------------------------------------------------------------------
FASTQC_DIR       = root / config["qc"]["fastqc_dir"]
MULTIQC_DIR      = root / config["qc"]["multiqc_dir"]
STAR_OUT         = root / config["alignment"]["star_out"]
FEATURECOUNTS_DIR = root / config["alignment"]["featurecounts_out"]
STAR_INDEX       = Path(config["indices"]["star"])
GTF              = Path(config["reference"]["gtf"])
THREADS          = config["threads"]
LOG_DIR          = root / config["pipeline_logs"]
EXACT_FC_MERGER  = Path(__file__).resolve().parent / "scripts" / "merge_featurecounts_exact.py"

# These existing cohorts are under the BG-001 immutable recount contract.  The
# shared workflow remains usable for their upstream FASTQ/STAR/QC rules and is a
# no-op when the aggregate counts already exist, but a forced/missing count rule
# must not rediscover BAMs or write a live canonical matrix.
BG001_AFFECTED_DATASETS = {
    "GSE130970", "GSE135251", "GSE174478", "GSE213621", "GSE240729",
}
DATASET_ID = root.name
BG001_RECOUNT_REQUIRED = DATASET_ID in BG001_AFFECTED_DATASETS
BG001_RECOUNT_REFUSAL = (
    f"ERROR: live {DATASET_ID} counting is disabled; use "
    "scripts/bg001_remediation/recount_array.sbatch with a frozen BAM manifest "
    "and candidate run root."
)
BG001_AGGREGATE_COUNTS = FEATURECOUNTS_DIR / "gene_counts.txt"
BG001_AGGREGATE_SUMMARY = FEATURECOUNTS_DIR / "gene_counts.txt.summary"
BG001_COUNTS_PRESENT = BG001_AGGREGATE_COUNTS.is_file() and BG001_AGGREGATE_SUMMARY.is_file()
# With a complete existing aggregate, no guarded rule claims its paths, keeping
# the count subgraph out of an ordinary DAG.  If either file is absent, the
# refusal rule claims both aggregate paths and fails immediately without BAM
# discovery or upstream dependencies.
BG001_PER_SAMPLE_GUARD_OUTPUTS = () if BG001_COUNTS_PRESENT else (
    str(FEATURECOUNTS_DIR / "per_sample" / "{sample}.counts.txt"),
    str(FEATURECOUNTS_DIR / "per_sample" / "{sample}.counts.txt.summary"),
)
BG001_MERGE_GUARD_OUTPUTS = () if BG001_COUNTS_PRESENT else (
    str(BG001_AGGREGATE_COUNTS),
    str(BG001_AGGREGATE_SUMMARY),
)

# ---------------------------------------------------------------------------
# Rule: all
# ---------------------------------------------------------------------------
rule all:
    input:
        expand(str(FASTQC_DIR / "{sample}_1_fastqc.html"), sample=SAMPLES),
        str(MULTIQC_DIR / "multiqc_report.html"),
        expand(str(STAR_OUT / "{sample}" / "{sample}.Aligned.sortedByCoord.out.bam"),
               sample=SAMPLES),
        str(FEATURECOUNTS_DIR / "gene_counts.txt"),
        str(FEATURECOUNTS_DIR / "gene_counts.txt.summary")

# ---------------------------------------------------------------------------
# Rule: FastQC
# ---------------------------------------------------------------------------
rule fastqc:
    input:
        lambda wc: fastq_paths(wc.sample)
    output:
        html = str(FASTQC_DIR / "{sample}_1_fastqc.html"),
        zip  = str(FASTQC_DIR / "{sample}_1_fastqc.zip")
    params:
        outdir = str(FASTQC_DIR)
    threads: THREADS["fastqc"]
    log: str(LOG_DIR / "fastqc" / "{sample}.log")
    shell:
        "mkdir -p {params.outdir} $(dirname {log}) && "
        "fastqc --threads {threads} --outdir {params.outdir} {input} > {log} 2>&1"

# ---------------------------------------------------------------------------
# Rule: STAR alignment (handles both paired-end and single-end)
# ---------------------------------------------------------------------------
rule star:
    input:
        fastqs = lambda wc: fastq_paths(wc.sample)
    output:
        bam       = str(STAR_OUT / "{sample}" / "{sample}.Aligned.sortedByCoord.out.bam"),
        sj        = str(STAR_OUT / "{sample}" / "{sample}.SJ.out.tab"),
        log_final = str(STAR_OUT / "{sample}" / "{sample}.Log.final.out")
    params:
        prefix = lambda wc: str(STAR_OUT / wc.sample / f"{wc.sample}."),
        star_index = str(STAR_INDEX),
        extra  = config.get("params", {}).get("star", {}).get("extra_flags", "")
    threads: THREADS["star"]
    log: str(LOG_DIR / "star" / "{sample}.log")
    shell:
        "mkdir -p $(dirname {params.prefix}) $(dirname {log}) && "
        "STAR --runThreadN {threads} "
        "--genomeDir {params.star_index} "
        "--readFilesIn {input.fastqs} "
        "--readFilesCommand zcat "
        "--outFileNamePrefix {params.prefix} "
        "--outSAMtype BAM SortedByCoordinate "
        "--twopassMode Basic "
        "--quantMode GeneCounts "
        "--limitBAMsortRAM 30000000000 "
        "{params.extra} > {log} 2>&1"

# ---------------------------------------------------------------------------
# Rules: featureCounts + merge. For affected cohorts, existing complete
# aggregates remain external inputs, whereas missing or explicitly forced count
# targets fail with a BG-001 refusal. Unrelated datasets retain the live workflow.
# ---------------------------------------------------------------------------
if BG001_RECOUNT_REQUIRED:
    rule featurecounts_per_sample:
        output: BG001_PER_SAMPLE_GUARD_OUTPUTS
        shell:
            "echo '{BG001_RECOUNT_REFUSAL}' >&2; exit 64"

    rule merge_featurecounts:
        output: BG001_MERGE_GUARD_OUTPUTS
        shell:
            "echo '{BG001_RECOUNT_REFUSAL}' >&2; exit 64"
else:
    rule featurecounts_per_sample:
        input:
            bam = str(STAR_OUT / "{sample}" / "{sample}.Aligned.sortedByCoord.out.bam")
        output:
            counts  = str(FEATURECOUNTS_DIR / "per_sample" / "{sample}.counts.txt"),
            summary = str(FEATURECOUNTS_DIR / "per_sample" / "{sample}.counts.txt.summary")
        params:
            gtf    = str(GTF),
            strand = config.get("params", {}).get("featurecounts", {}).get("strandedness", "0"),
            pe_flag = lambda wc: "-p --countReadPairs -B" if is_paired(wc.sample) else ""
        threads: THREADS["featurecounts"]
        log: str(LOG_DIR / "featurecounts" / "{sample}.log")
        shell:
            "mkdir -p $(dirname {output.counts}) $(dirname {log}) && "
            "featureCounts -T {threads} {params.pe_flag} -s {params.strand} "
            "-a {params.gtf} -o {output.counts} {input.bam} > {log} 2>&1"

    rule merge_featurecounts:
        input:
            counts = expand(str(FEATURECOUNTS_DIR / "per_sample" / "{sample}.counts.txt"),
                            sample=SAMPLES),
            summaries = expand(str(FEATURECOUNTS_DIR / "per_sample" / "{sample}.counts.txt.summary"),
                               sample=SAMPLES)
        output:
            merged  = str(FEATURECOUNTS_DIR / "gene_counts.txt"),
            summary = str(FEATURECOUNTS_DIR / "gene_counts.txt.summary")
        params:
            per_sample_dir = str(FEATURECOUNTS_DIR / "per_sample")
        log: str(LOG_DIR / "merge_featurecounts.log")
        run:
            command = [
                sys.executable, str(EXACT_FC_MERGER),
                "--per-sample-dir", str(params.per_sample_dir),
                "--output", str(output.merged),
                "--summary", str(output.summary),
                "--log", str(log),
            ]
            for sample in SAMPLES:
                command.extend(("--sample-id", sample))
            subprocess.run(command, check=True)

# ---------------------------------------------------------------------------
# Rule: MultiQC
# ---------------------------------------------------------------------------
rule multiqc:
    input:
        expand(str(STAR_OUT / "{sample}" / "{sample}.Log.final.out"), sample=SAMPLES),
        str(FEATURECOUNTS_DIR / "gene_counts.txt")
    output:
        str(MULTIQC_DIR / "multiqc_report.html")
    params:
        outdir = str(MULTIQC_DIR)
    log: str(LOG_DIR / "multiqc.log")
    shell:
        "mkdir -p {params.outdir} $(dirname {log}) && "
        "multiqc {root} -o {params.outdir} --force > {log} 2>&1"
